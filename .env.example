# Développement local uniquement. Ne pas réutiliser ces valeurs hors de la machine.
BRIGHTNET_LISTEN=127.0.0.1:8787
BRIGHTNET_UI_LISTEN=127.0.0.1:1717
BRIGHTNET_BNCP_LISTEN=127.0.0.1:1718
BRIGHTNET_WEB_ROOT=
BRIGHTNET_DATA=./data/brightnet.db
BRIGHTNET_ADMIN_USER=admin
BRIGHTNET_ADMIN_PASSWORD=brightnet-dev
BRIGHTNET_DEV_PAIRING_CODE=brightnet-dev-pair
# Laisser vide pour parler BNCP. Renseigner l'URL pour rester en JSON HTTP.
BRIGHTNET_CORE_URL=
BRIGHTNET_BNCP_ADDR=127.0.0.1:1718
BRIGHTNET_PAIRING_CODE=brightnet-dev-pair
BRIGHTNET_STATE=./data/agent-state.json
BRIGHTNET_DOCKER_SOCKET=/var/run/docker.sock
BRIGHTNET_MACHINE_ID_PATH=/etc/machine-id
VITE_API_PROXY=http://127.0.0.1:8787
